# Sinh giá trị mới bằng: npx auth secret   (hoặc node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Tạo OAuth Client (loại "Web application") tại https://console.cloud.google.com/apis/credentials
# Thêm Authorized redirect URI: http://localhost:8000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dùng cho metadataBase / sitemap / robots khi deploy thật (mặc định localhost:8000)
NEXT_PUBLIC_SITE_URL=http://localhost:8000
